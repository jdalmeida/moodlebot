# --- Execução ---
# telegram = roda como bot (precisa de TELEGRAM_BOT_TOKEN + ALLOWED_USER_IDS)
# terminal = assistente interativo no terminal (não precisa de bot)
RUN_MODE=telegram

# --- Moodle ---
MOODLE_BASE_URL=https://portalvirtual.unisc.br/moodle
MOODLE_STORAGE_STATE=data/storage_state.json
MOODLE_HEADLESS=false
MOODLE_REQUEST_TIMEOUT_MS=30000

# Valores aceitos:
# "chrome", "msedge", "chromium" ou "" para usar o Chromium baixado pelo Playwright.
BROWSER_CHANNEL=chrome
# Override explícito (raro — preencha só se o `channel` acima não bastar).
# Ex.: /usr/bin/google-chrome
BROWSER_EXECUTABLE_PATH=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# IDs separados por vírgula. Para descobrir seu user_id, fale com @userinfobot
TELEGRAM_ALLOWED_USER_IDS=

# --- Banco ---
DATABASE_PATH=data/moodlebot.db

# --- Scheduler ---
POLL_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# --- LLM (Gemini via google-genai) ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash

# --- Submitter ---
# true = abre navegador visível só quando o submitter rodar (útil para
# ajustar seletores). Independente de MOODLE_HEADLESS.
MOODLE_DEBUG=false
